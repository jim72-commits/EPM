# Copy to .env.local for development. Never commit secrets.

# Supabase (https://supabase.com/dashboard) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: service role for admin scripts and moderation transitions —
# never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL for building absolute redirects (auth callbacks, newsletter
# confirmation links, sitemap, canonical URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — https://resend.com/api-keys). Leave blank to log emails to
# the server console instead of sending. Useful for local dev.
RESEND_API_KEY=
# Must be a verified sender on your Resend account.
EMAIL_FROM=TheCOE <hello@thecoe.com>

# Job-alert digest cron. Generate any high-entropy string; Vercel Cron and
# manual curl both authenticate with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Analytics (optional). Leave blank to disable. Plausible is privacy-friendly
# and cookieless; no consent banner required.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Override for self-hosted Plausible. Defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
